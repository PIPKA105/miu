<?xml version='1.0' encoding='utf-8'?>
<widget id="com.foxai.gtaports" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>GTA PORTS LAUNCHER</name>
    <description>Лаунчер проверенных портов GTA от FoxAI + встроенная мини-игра с экранным джойстиком.</description>
    <author href="https://github.com" email="fox@foxai.app">FoxAI</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="market:*" />
    <allow-intent href="intent:*" />
    <preference name="Orientation" value="portrait" />
    <preference name="BackgroundColor" value="0xff0b0620" />
    <preference name="android-minSdkVersion" value="24" />
    <preference name="android-targetSdkVersion" value="34" />
    <preference name="AndroidWindowSplashScreenBackground" value="#0b0620" />
    <preference name="AndroidLaunchMode" value="singleTask" />
    <platform name="android">
        <icon src="icon.png" />
    </platform>
</widget>
